@model SchoolSystem.Models.Student

@{
    ViewData["Title"] = "Student Details";
}

<h2 class="mb-4">Student Details</h2>

<dl class="row mb-4">
    <dt class="col-sm-2">Id</dt>
    <dd class="col-sm-10">@Model.Id</dd>

    <dt class="col-sm-2">Name</dt>
    <dd class="col-sm-10">@Model.Name</dd>

    <dt class="col-sm-2">Age</dt>
    <dd class="col-sm-10">@Model.Age</dd>

    <dt class="col-sm-2">Department</dt>
    <dd class="col-sm-10">@Model.Department?.Name</dd>
</dl>

<h4>Courses &amp; Grades</h4>

@if (Model.StuCrsRes.Any())
{
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Course Name</th>
                <th>Degree</th>
                <th>Grade</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var result in Model.StuCrsRes)
            {
                <tr>
                    <td>@result.Course?.Name</td>
                    <td>@result.Course?.Degree</td>
                    <td>@result.Grade</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No courses enrolled.</p>
}

<a asp-action="ShowAll" class="btn btn-secondary mt-2">Back to list</a>
